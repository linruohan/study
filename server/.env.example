# 复制为 .env 后按需修改；下面这份是 WSL2 本地环境的默认值。
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# PostgreSQL（WSL2 内由 systemd 管理，监听 5432）
DATABASE_URL=postgres://study:study_dev_password@127.0.0.1:5432/study

# 对象存储（S3 协议；本地用 SeaweedFS，配置与 MinIO 完全通用）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=study_minio
S3_SECRET_KEY=study_minio_secret
S3_BUCKET=study-assets

# 单个文件上限，单位 MB
MAX_UPLOAD_MB=50
# 预签名地址有效期，单位秒
SIGNED_URL_TTL_SECONDS=900
# 允许的跨域来源，* 表示全放开；多个用逗号分隔
CORS_ORIGIN=*
