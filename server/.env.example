# 复制为 .env 后按需修改;下面这份是 Docker 本地环境的默认值。
# 依赖服务用 Docker 部署:在 server/ 下执行 docker compose up -d,
# PostgreSQL 16 与 MinIO 的端口、凭据、数据卷见 server/docker-compose.yml。
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# PostgreSQL(Docker 容器 study-postgres 映射到 localhost:5432)
DATABASE_URL=postgres://study:study_dev_password@localhost:5432/study

# 对象存储(S3 协议;Docker 容器 study-minio 映射到 localhost:9000)
# 凭据对应 docker-compose.yml 里的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=study_minio
S3_SECRET_KEY=study_minio_secret
S3_BUCKET=study-assets

# 单个文件上限,单位 MB
MAX_UPLOAD_MB=50
# 预签名地址有效期,单位秒
SIGNED_URL_TTL_SECONDS=900
# 允许的跨域来源,* 表示全放开;多个用逗号分隔
CORS_ORIGIN=*
