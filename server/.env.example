# 复制为 .env 后按需修改；下面这份就是 docker-compose.yml 的默认值。
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# PostgreSQL（对应 docker-compose.yml 里的 postgres 服务）
DATABASE_URL=postgres://study:study_dev_password@127.0.0.1:5432/study

# MinIO（S3 兼容）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=study_minio
S3_SECRET_KEY=study_minio_secret
S3_BUCKET=study-assets

# 单个文件上限，单位 MB
MAX_UPLOAD_MB=50
# 预签名地址有效期，单位秒
SIGNED_URL_TTL_SECONDS=900
# 允许的跨域来源，* 表示全放开；多个用逗号分隔
CORS_ORIGIN=*
