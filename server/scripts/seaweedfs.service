[Unit]
Description=SeaweedFS S3 compatible object storage
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/weed server -dir=/var/lib/seaweedfs -ip=127.0.0.1 -ip.bind=0.0.0.0 -s3 -s3.port=9000 -s3.config=/etc/seaweedfs/s3.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
